# docker-compose.prod.yml 용 환경변수. 복사해서 .env 로 저장 후 실제 값 채우기.
# .env 파일 자체는 git에 커밋하지 않는다.

# daisy 호스트에서 이 컨테이너로 매핑할 포트 (daisy nginx가 /juntaek/api -> 이 포트로 프록시)
# 이 프로젝트는 기존에 같은 경로를 쓰던 컨테이너가 물려있던 포트(18090)를 재사용함
APP_PORT=18090

# daisy nginx(regex 라우팅)가 /juntaek/api 프리픽스를 이미 떼고 넘겨줌 -> 비워둠
# (nginx location ~ ^/([^/]+)/([^/]+)(/.*)?$ 가 member/app 두 세그먼트를 떼고 나머지만 프록시)
SERVER_CONTEXT_PATH=

# MySQL
MYSQL_ROOT_PASSWORD=
DB_USERNAME=
DB_PASSWORD=

# 외부 API
OPENAI_API_KEY=
KMA_SERVICE_KEY=
BUILDING_REGISTRY_SERVICE_KEY=

# CORS: Vercel 프론트 도메인 (예: https://coolroof-monitoring.vercel.app)
CORS_ALLOWED_ORIGIN=
